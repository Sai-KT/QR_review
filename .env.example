# QR_review — Public Client Configuration (Example Template)
# These values are placeholders for local frontend development.
# DO NOT add elevated secrets (e.g. SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY) to this file.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_ANON_KEY
VITE_APP_URL=http://localhost:5173

# Server-Only Supabase Edge Functions Secrets (M3-T03)
# Set via `supabase secrets set` or local Edge Functions .env (NEVER expose to VITE_ frontend bundles)
# Must be a 32-byte (256-bit) cryptographically random secret encoded as 64 hexadecimal characters.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBMISSION_SIGNING_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef


